read_sample_ids <- function(file, id_column, file_type = "auto",
sheet = 1) {
# 1. Validate file path
if (!is.character(file) || length(file) != 1 ||
is.na(file) || !nzchar(file)) {
stop("Provide one valid file path.", call. = FALSE)
}
if (!file.exists(file)) {
stop("File does not exist.", call. = FALSE)
}
# 2. Validate ID column
if (!(is.character(id_column) &&
length(id_column) == 1 &&
!is.na(id_column) &&
nzchar(id_column)) &&
!(is.numeric(id_column) &&
length(id_column) == 1 &&
!is.na(id_column) &&
id_column >= 1 &&
id_column == as.integer(id_column))) {
stop(
"id_column must be a column name or a positive integer.",
call. = FALSE
)
}
# 3. Detect file type
allowed_types <- c("auto", "csv", "tsv", "txt", "xlsx", "xls")
if (!is.character(file_type) ||
length(file_type) != 1 ||
is.na(file_type) ||
!file_type %in% allowed_types) {
stop("Unsupported file_type.", call. = FALSE)
}
if (file_type == "auto") {
extension <- tolower(tools::file_ext(file))
file_type <- extension
if (!file_type %in% allowed_types[-1]) {
stop("Could not detect a supported file format.",
call. = FALSE)
}
}
# 4. Read the file
if (file_type == "csv") {
data <- utils::read.csv(
file,
colClasses = "character",
check.names = FALSE,
na.strings = character(),
strip.white = FALSE
)
} else if (file_type %in% c("tsv", "txt")) {
data <- utils::read.delim(
file,
colClasses = "character",
check.names = FALSE,
na.strings = character(),
strip.white = FALSE
)
} else {
if (!requireNamespace("readxl", quietly = TRUE)) {
stop(
"Package 'readxl' is required to read Excel files. Install it with install.packages('readxl').",
call. = FALSE
)
}
data <- as.data.frame(
readxl::read_excel(
file,
sheet = sheet,
col_types = "text",
.name_repair = "minimal"
),
check.names = FALSE
)
}
# 5. Identify requested column
if (is.numeric(id_column)) {
if (id_column > ncol(data)) {
stop("Requested column index does not exist.",
call. = FALSE)
}
column_index <- as.integer(id_column)
} else {
column_index <- which(names(data) == id_column)
if (length(column_index) == 0) {
stop("Requested ID column was not found.",
call. = FALSE)
}
if (length(column_index) > 1) {
stop("The requested column name is ambiguous.",
call. = FALSE)
}
}
# 6. Extract sample identifiers
ids <- data[[column_index]]
# 7. Return character vector
as.character(ids)
}
